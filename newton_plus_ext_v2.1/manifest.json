{
  "manifest_version": 3,
  "name": "Newton Attendance Viewer",
  "version": "1.0",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_width": 500,
    "default_height": 700
  },
  "content_scripts": [
    {
      "matches": [
        "https://my.newtonschool.co/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}